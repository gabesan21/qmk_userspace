*.bak
*.swp
*~
.DS_Store
._*

# Firmware files
*.hex
*.bin
*.uf2

# Executável local do monitor de camadas
/monitor-camadas/monitor-camadas

# unirepo-harness: preserve the standalone anatomy in Git
!pop/worktrees/
pop/worktrees/*
!pop/worktrees/.gitkeep
# unirepo-harness: scripts' bytecode
__pycache__/
